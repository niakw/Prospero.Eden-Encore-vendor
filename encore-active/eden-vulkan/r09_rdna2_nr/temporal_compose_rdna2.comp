#version 450
// SPDX-License-Identifier: MIT
// R09 neural temporal output: authentic learned RGB residual + fourth
// temporal logit, externally supplied valid motion and previous history.
layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
layout(set=0,binding=0,std430) readonly buffer Proxy {vec4 color[];} proxy;
layout(set=0,binding=1,std430) readonly buffer ModelHead {uint packed[];} head;
layout(set=0,binding=2,std430) readonly buffer Motion {vec4 vector[];} motion;
layout(set=0,binding=3,std430) readonly buffer History {vec4 color[];} previous;
layout(set=0,binding=4,std430) writeonly buffer Output {vec4 color[];} out_color;
layout(set=0,binding=5,std430) writeonly buffer Next {vec4 color[];} next_history;
layout(push_constant) uniform Params {
    uint width, height;
    float intensity, blend_scale;
    uint history_valid, reserved0, reserved1, reserved2;
} pc;
bool finite1(float x) {return !isnan(x)&&!isinf(x);}
bool finite3(vec3 x) {return !any(isnan(x))&&!any(isinf(x));}
vec3 bilinearHistory(vec2 pixel) {
    vec2 xy=clamp(pixel-0.5,vec2(0.0),
                  vec2(pc.width-1u,pc.height-1u));
    ivec2 a=ivec2(floor(xy));
    ivec2 b=min(a+ivec2(1),ivec2(pc.width,pc.height)-1);
    vec2 t=fract(xy);
    vec3 c00=previous.color[uint(a.y)*pc.width+uint(a.x)].rgb;
    vec3 c10=previous.color[uint(a.y)*pc.width+uint(b.x)].rgb;
    vec3 c01=previous.color[uint(b.y)*pc.width+uint(a.x)].rgb;
    vec3 c11=previous.color[uint(b.y)*pc.width+uint(b.x)].rgb;
    return mix(mix(c00,c10,t.x),mix(c01,c11,t.x),t.y);
}
vec3 catmullRomHistory(vec2 pixel){
    // Five bilinear taps (4 axes + center), per OpenDLSS-NR reference.
    vec2 base=floor(pixel-0.5)+0.5;
    vec2 t=clamp(pixel-base,vec2(0.0),vec2(1.0));
    vec2 s=t*t,c=t*s;
    vec2 w0=s-0.5*(t+c),w1=1.0-2.5*s+1.5*c;
    vec2 w3=0.5*(c-s),w2=1.0-w0-w1-w3;
    vec2 middle=w1+w2;
    if(any(lessThanEqual(middle,vec2(0.00001))))
        return bilinearHistory(pixel);
    vec2 center=base+w2/middle;
    float a=w0.x*middle.y,b=w0.y*middle.x;
    float cc=middle.x*middle.y,d=w3.y*middle.x,e=w3.x*middle.y;
    float norm=a+b+cc+d+e;
    if(abs(norm)<0.00001)return bilinearHistory(pixel);
    vec3 result=(bilinearHistory(vec2(base.x-1.0,center.y))*a+
                 bilinearHistory(vec2(center.x,base.y-1.0))*b+
                 bilinearHistory(center)*cc+
                 bilinearHistory(vec2(center.x,base.y+2.0))*d+
                 bilinearHistory(vec2(base.x+2.0,center.y))*e)/norm;
    return finite3(result)?clamp(result,0.0,1.0):vec3(0.0);
}
float truncateHalf(float v){
    uint bits=floatBitsToUint(clamp(v,0.0,1.0));
    uint exponent=(bits>>23u)&255u, mantissa=bits&0x7fffffu;
    int h=int(exponent)-112;
    uint raw=0u;
    if(h>0)raw=(uint(h)<<10u)|(mantissa>>13u);
    else if(h>=-10)raw=(mantissa|0x800000u)>>uint(14-h);
    return unpackHalf2x16(raw).x;
}
void main(){
    uvec2 xy=gl_GlobalInvocationID.xy;
    if(xy.x>=pc.width||xy.y>=pc.height)return;
    uint idx=xy.y*pc.width+xy.x, offset=idx*8u;
    vec4 proxy_pixel=proxy.color[idx];
    vec3 base=finite3(proxy_pixel.rgb)?
        clamp(proxy_pixel.rgb,0.0,1.0):vec3(0.0);
    vec2 r01=unpackHalf2x16(head.packed[offset]);
    vec2 r2_logit=unpackHalf2x16(head.packed[offset+1u]);
    vec3 delta=vec3(r01,r2_logit.x);
    vec3 neural=finite3(delta)?clamp(base+delta*0.25,0.0,1.0):base;
    if(pc.history_valid==1u&&finite1(r2_logit.y)){
        vec4 m=motion.vector[idx];
        if(finite1(m.x)&&finite1(m.y)&&finite1(m.z)&&m.z>0.5){
            vec2 previous_uv=(vec2(xy)+0.5)/vec2(pc.width,pc.height)+m.xy;
            if(all(greaterThanEqual(previous_uv,vec2(0.0)))&&
               all(lessThan(previous_uv,vec2(1.0)))){
                float w=clamp(pc.blend_scale/
                    (1.0+exp(-r2_logit.y)),0.0,1.0);
                neural=mix(neural,catmullRomHistory(
                    previous_uv*vec2(pc.width,pc.height)),w);
            }
        }
    }
    vec3 published=vec3(truncateHalf(neural.r),truncateHalf(neural.g),
                        truncateHalf(neural.b));
    next_history.color[idx]=vec4(published,1.0);
    float alpha=finite1(proxy_pixel.a)?
        clamp(proxy_pixel.a,0.0,1.0):1.0;
    out_color.color[idx]=vec4(
        mix(base,published,pc.intensity),alpha);
}
