#version 450
// SPDX-License-Identifier: MIT
// RDNA2 shared decoder epilogue: FP32 GEMM scratch to FP16 projection.
// Exactly one 32-bit output word per two independently half-rounded values.
layout(local_size_x=128,local_size_y=1,local_size_z=1) in;
layout(set=0,binding=0,std430) readonly buffer DecoderFp32 {float values[];} source;
layout(set=0,binding=1,std430) buffer DecoderFp16 {uint words[];} destination;
layout(push_constant) uniform Params {
    uint elements;
    uint input_offset_floats;
    uint output_offset_halfwords;
} pc;
void main(){
    uint pair=gl_GlobalInvocationID.x;
    if(pair>=pc.elements/2u)return;
    uint i=pc.input_offset_floats+2u*pair;
    uint o=pc.output_offset_halfwords/2u+pair;
    destination.words[o]=packHalf2x16(vec2(source.values[i],
                                          source.values[i+1u]));
}
