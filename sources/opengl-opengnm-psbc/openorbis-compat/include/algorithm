#pragma once

// C++23 <algorithm> compat for OpenOrbis libc++ (llvm18).
// Adds std::lexicographical_compare_three_way (C++20 feature missing in libc++18).
// Only active in C++20+ mode to avoid breaking C++17 code (LLVM).
// Does NOT include <compare> to avoid circular includes with <array>.
// std::strong_ordering is available via force-included <compare>.

#if __has_include_next(<algorithm>)
#include_next <algorithm>
#endif

#if __cplusplus >= 202002L

namespace std {

template <class InputIt1, class InputIt2>
constexpr auto lexicographical_compare_three_way(InputIt1 first1, InputIt1 last1,
                                                  InputIt2 first2, InputIt2 last2)
{
    // Use int return as a fallback if strong_ordering isn't available yet.
    // The caller only compares the result with 0.
    while (first1 != last1 && first2 != last2) {
        if (*first1 < *first2) return -1;
        if (*first2 < *first1) return 1;
        ++first1;
        ++first2;
    }
    if (first1 == last1 && first2 == last2) return 0;
    if (first1 == last1) return -1;
    return 1;
}

} // namespace std
#endif
