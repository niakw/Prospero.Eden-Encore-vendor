prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: opengnm
Description: Clean-rewrite PS4 GNM library
Version: @PROJECT_VERSION@
Cflags: -I${includedir}
Libs: -L${libdir} -lopengnm
Libs.private: @OPENGNM_PKGCONFIG_LIBS_PRIVATE@
